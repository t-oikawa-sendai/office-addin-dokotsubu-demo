<?xml version="1.0" encoding="UTF-8"?>
<!--
ソース名: manifest.prod.sample.xml
Lang: XML
Function: HTTPS 配信を想定したマニフェスト雛形（コピーして編集）
Note: YOUR-HOST.example と Id を置換。ローカルは manifest.local.xml を使う。
Author:Takashi Oikawa
Date:2026/04/04
LastUp:2026/04/04
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>b8a3d7c2-1e4f-496a-b5c4-3210fedcba98</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>DokoTsubu Demo</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="どこつぶ（デモ）"/>
  <Description DefaultValue="説明用モック: 投稿一覧のみ。認証・DB・シート操作なし。"/>
  <IconUrl DefaultValue="https://YOUR-HOST.example/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://YOUR-HOST.example/icon-80.png"/>
  <SupportUrl DefaultValue="https://YOUR-HOST.example/support.html"/>
  <AppDomains>
    <AppDomain>https://YOUR-HOST.example</AppDomain>
  </AppDomains>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://YOUR-HOST.example/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
</OfficeApp>
